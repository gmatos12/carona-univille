{
  "name": "carona-univille-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run --maxWorkers=1 --hookTimeout=120000",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --testTimeout=30000 --hookTimeout=120000 --coverage.thresholds.statements=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80",
    "db:migrate": "node src/db/migrations/run.js",
    "db:seed": "node src/db/seeds/run.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "supertest": "^7.3.2",
    "vitest": "^4.1.12"
  }
}
